    "Control podcast playback and see your Up Next queue." : {
      "comment" : "Description of the 'Now Playing' Home Screen widget shown in the widget gallery when the user picks a widget to add. 'Up Next' is the app's screen name for the Queue (the ordered list of episodes to play) — use the same wording as elsewhere in the app for Up Next.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podcast-Wiedergabe steuern und die Warteliste „Als Nächstes“ ansehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controla la reproducción de podcasts y consulta tu cola A continuación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contrôlez la lecture et consultez votre file d'attente À suivre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla la riproduzione dei podcast e consulta la coda Prossimi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedien het afspelen van podcasts en bekijk je wachtrij."
          }
        }
      }
    },
