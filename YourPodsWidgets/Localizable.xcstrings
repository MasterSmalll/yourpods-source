    "Play or pause the current episode." : {
      "comment" : "One-line description of the widget's play/pause action, shown under the action's name when the user browses actions in the Shortcuts app or Siri. Imperative sentence: the single button switches between playing and paused. Keep it to one short sentence.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
