    "No episodes queued" : {
      "comment" : "Empty-state line meaning the Queue (the ordered list of episodes to play) contains nothing. It appears as small caption text directly under the app name 'YourPods' in the Apple Watch face / iPhone Lock Screen complication AND in the Home Screen widget's empty state. Space is the hard constraint: a complication gives roughly one short line and anything longer is truncated.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warteliste leer"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin episodios en cola"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File d'attente vide"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coda vuota"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niets in de wachtrij"
          }
        }
      }
    },
    "Nothing Playing" : {
      "comment" : "Empty-state title shown in the full-screen player, and in the Home Screen widget, when no episode is loaded. Very little room in the widget.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Wiedergabe"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada en reproducción"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune lecture"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna riproduzione"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er speelt niets"
          }
        }
      }
    },
    "Now Playing" : {
      "comment" : "The standard media term for what is playing right now. Used as a section header above the current episode on the home screen and in the Up Next queue screen, as the navigation title of the Apple Watch remote-control screen, and as the disabled label of the play button in episode details when that episode is already the one playing.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktuelle Wiedergabe"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduciendo ahora"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lecture en cours"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In riproduzione"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speelt nu"
          }
        }
      }
    },
    "Now playing and up next from your podcast queue." : {
      "comment" : "Description of the YourPods complication shown in the picker when the user chooses a complication to add to an Apple Watch face or the iPhone Lock Screen. 'Up next' means the episode that follows the current one in the Queue (the ordered list of episodes to play). YourPods is the product name and is never translated.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktuelle Wiedergabe und die nächste Folge aus deiner Podcast-Warteliste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que suena ahora y lo siguiente de tu cola de podcasts."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lecture en cours et épisodes à suivre de votre file d'attente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In riproduzione e prossimi episodi dalla tua coda di podcast."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wat er nu speelt en wat er volgt in je wachtrij."
          }
        }
      }
    },
    "Open YourPods to start listening" : {
      "comment" : "The third and smallest line of the Home Screen widget's empty state, below 'YourPods' and 'No episodes queued' — a prompt to open the app. YourPods is the product name and is never translated. Rendered in the widget's smallest caption size and truncated if long; the English deliberately has no full stop.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
