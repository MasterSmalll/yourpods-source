          }
        }
      }
    },
    "End of episode" : {
      "comment" : "Option in the Apple Watch sleep-timer dialog: keep playing until the current episode finishes, then stop. It is the watch's equivalent of DriftOff Mode on iPhone. A duration choice listed beside '15 minutes', '30 minutes', '1 hour'.",
      "localizations" : {
