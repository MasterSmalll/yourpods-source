          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download"
          }
        }
      }
    },
    "Download to Watch" : {
      "comment" : "Button that downloads the episode's audio onto the Apple Watch itself, so it plays without the iPhone. 'Watch' is the DEVICE (Apple Watch), never the verb 'to watch'.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
