      }
    },
    "Chapters (%lld)" : {
      "comment" : "Button label showing how many chapters the current episode has, e.g. 'Chapters (12)'. Appears on a small pill under the mini player, in the mini-player overflow menu, and as an expand/collapse row on the Apple Watch. The argument counts chapters — marked sections inside this one episode. Space on the pill is very tight.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
