    "Sleep Timer" : {
      "comment" : "The feature that stops playback after a set time so the user can fall asleep. Used as the title of the sleep-timer sheet, as a mini-player menu item, as the short name of a Siri/Shortcuts action, and as a button and VoiceOver label on the Apple Watch.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep-Timer"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temporizador para dormir"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minuteur de veille"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timer di spegnimento"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slaaptimer"
          }
        }
      }
    },
    "Sync episodes from the iPhone app." : {
      "comment" : "Body text of the empty state on the watch's main list when no episodes have been synced to the watch yet; it tells the user to send episodes over from the app on their iPhone.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folgen aus der iPhone-App synchronisieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincroniza episodios desde la app del iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisez des épisodes depuis l'app iPhone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronizza gli episodi dall'app su iPhone."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchroniseer afleveringen vanuit de iPhone-app."
          }
        }
      }
    },
    "Tap to try again." : {
      "comment" : "Small caption under the 'Couldn't Load Episodes' headline on the Apple Watch episode list; the whole empty state is a tappable button that retries the request to the phone. Instruction to tap the watch screen. One short line only.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Wiederholen tippen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca para reintentar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez pour réessayer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca per riprovare."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik om opnieuw te proberen."
          }
        }
      }
    },
    "This podcast has no episodes on your iPhone." : {
      "comment" : "Small caption on the Apple Watch episode list, shown when the paired phone did reply but has no episodes stored for this show. 'Podcast' here means the show, not one episode. iPhone is Apple's product name and is never translated. Tiny caption on a watch screen — keep it short.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Podcast hat auf deinem iPhone keine Folgen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este podcast no tiene episodios en tu iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce podcast n'a aucun épisode sur votre iPhone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo podcast non ha episodi sul tuo iPhone."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze podcast heeft geen afleveringen op je iPhone."
          }
        }
      }
    },
