    "All caught up!" : {
      "comment" : "Headline of the empty state on the Apple Watch 'Recent' screen, shown with a green checkmark when there are no new unplayed episodes left — a congratulation that the user has listened to everything. A follow-up caption ('No new episodes from your subscriptions.') sits below it. Headline on a watch screen: must stay very short or it wraps and truncates.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles gehört!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Todo al día!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout est à jour !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei in pari!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helemaal bij!"
          }
        }
      }
    },
    "Cancel" : {
      "comment" : "Standard dismiss button: the toolbar of the note editor, and the safe choice in confirmation dialogs for destructive actions. The verb meaning 'abandon this action, change nothing' — not cancelling a subscription or a timer.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbrechen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancelar"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annuler"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annulla"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annuleer"
          }
        }
      }
    },
    "Cancel Timer" : {
      "comment" : "Destructive button that stops the running sleep timer (and the short name of the matching Siri/Shortcuts action). 'Timer' is the sleep timer; 'cancel' here means turn it off so playback keeps going.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timer beenden"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancelar temporizador"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annuler le minuteur"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annulla timer"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annuleer timer"
          }
        }
      }
    },
    "Chapter: %@" : {
      "comment" : "VoiceOver label for one row of the chapter list on the Apple Watch. The argument is the chapter title; a chapter is a marked section inside one episode. The start time is spoken separately as the element's value. Heard, not read.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapitel: %@"
          }
