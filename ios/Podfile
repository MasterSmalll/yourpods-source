# Workaround: Xcode 26.2 uses project object version 70,
# which xcodeproj gem doesn't support yet. Ruby 4.0 freezes
# literal hashes, so we must replace the entire constant.
require 'xcodeproj'
unless Xcodeproj::Constants::COMPATIBILITY_VERSION_BY_OBJECT_VERSION.key?(70)
  patched = Xcodeproj::Constants::COMPATIBILITY_VERSION_BY_OBJECT_VERSION.dup
  patched[70] = 'Xcode 16.0'
  Xcodeproj::Constants.send(:remove_const, :COMPATIBILITY_VERSION_BY_OBJECT_VERSION)
  Xcodeproj::Constants.const_set(:COMPATIBILITY_VERSION_BY_OBJECT_VERSION, patched.freeze)
end

# Uncomment this line to define a global platform for your project
platform :ios, '14.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_modular_headers!
  inhibit_all_warnings!
  # use_frameworks! :linkage => :static

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    # Enforce minimum deployment target to suppress 'IPHONEOS_DEPLOYMENT_TARGET is set to 9.0' warnings
    target.build_configurations.each do |config|
      if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 14.0
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '14.0'
      end
    end

    # Fix: Move .xcprivacy files from Compile Sources → Resources.
    # Some pods (flutter_app_group_directory, live_activities) include
    # PrivacyInfo.xcprivacy as source files, but Xcode has no compile
    # rule for text.xml — they should be resources instead.
    target.build_phases.each do |phase|
      if phase.is_a?(Xcodeproj::Project::Object::PBXSourcesBuildPhase)
        phase.files.reject! do |file|
          if file.file_ref&.path&.end_with?('.xcprivacy')
            # Move to Resources instead
            resources_phase = target.build_phases.find { |p| p.is_a?(Xcodeproj::Project::Object::PBXResourcesBuildPhase) }
            resources_phase&.add_file_reference(file.file_ref) if resources_phase
            true
          end
        end
      end
    end
  end

  # Fix native asset framework MinimumOSVersion to match deployment target.
  # Works around stale build caches where objective_c.framework gets
  # MinimumOSVersion=12.0 instead of 14.0 (upstream bug in flutter SDK + objective_c).
  # Uses plutil instead of regex to safely handle both XML and binary plist formats.
  native_assets_dir = File.join(__dir__, '..', 'build', 'native_assets', 'ios')
  if Dir.exist?(native_assets_dir)
    Dir.glob(File.join(native_assets_dir, '**', 'Info.plist')).each do |plist|
      current_ver = `plutil -extract MinimumOSVersion raw "#{plist}" 2>/dev/null`.strip
      if !current_ver.empty? && current_ver != '14.0'
        system('plutil', '-replace', 'MinimumOSVersion', '-string', '14.0', plist)
        puts "[YourPods] Fixed MinimumOSVersion in #{File.basename(File.dirname(plist))}/Info.plist: #{current_ver} → 14.0"
      end
    end

    # Note: objective_c.framework binary platform fix (IOSSIMULATOR → IOS) is
    # handled by the Runner build phase below, which only runs during
    # Archive/Release builds. Do NOT patch binaries here at pod-install time,
    # as that would break Simulator debug builds.
  end

  # Add a build phase to the Runner target to fix native asset framework platforms
  # at archive time (in case the cache is regenerated between pod install and archive).
  runner_target = installer.aggregate_targets
    .flat_map(&:user_targets)
    .find { |t| t.name == 'Runner' }
  if runner_target
    phase_name = '[YourPods] Fix Native Asset Framework Platforms'
    existing = runner_target.shell_script_build_phases.find { |p| p.name == phase_name }
    if existing
      runner_target.build_phases.delete(existing)
    end
    phase = runner_target.new_shell_script_build_phase(phase_name)
    phase.shell_script = <<~SCRIPT
      # Only run during Archive builds to avoid slowing debug builds
      if [ "${ACTION}" = "install" ] || [ "${CONFIGURATION}" = "Release" ]; then
        APP_FRAMEWORKS_DIR="${TARGET_BUILD_DIR}/${WRAPPER_NAME}/Frameworks"
        if [ -d "$APP_FRAMEWORKS_DIR" ]; then
          find "$APP_FRAMEWORKS_DIR" -maxdepth 1 -name "*.framework" -type d | while read fw; do
            binary="$fw/$(basename "$fw" .framework)"
            plist="$fw/Info.plist"

            # Fix 1: Info.plist MinimumOSVersion must match deployment target
            if [ -f "$plist" ]; then
              CURRENT_VER=$(/usr/bin/plutil -extract MinimumOSVersion raw "$plist" 2>/dev/null || echo "")
              if [ -n "$CURRENT_VER" ] && [ "$CURRENT_VER" != "14.0" ]; then
                /usr/bin/plutil -replace MinimumOSVersion -string "14.0" "$plist"
                echo "[YourPods] Fixed $(basename "$fw")/Info.plist MinimumOSVersion: $CURRENT_VER → 14.0"
              fi
            fi

            # Fix 2: Binary must not reference IOSSIMULATOR platform
            if [ -f "$binary" ]; then
              if vtool -show "$binary" 2>/dev/null | grep -q "IOSSIMULATOR"; then
                vtool -set-build-version ios 14.0 26.2 -replace -output "$binary" "$binary"
                codesign --force --sign - "$binary"
                echo "[YourPods] Fixed $(basename "$fw") platform: IOSSIMULATOR → IOS"
              fi
            fi
          done
        fi
      fi
    SCRIPT
  end

  # Strip extended attributes (com.apple.provenance) that break code signing
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['CODE_SIGN_ALLOW_ENTITLEMENTS_MODIFICATION'] = 'YES'
    end
  end

  # Add a script phase to strip extended attributes before code signing
  installer.pods_project.targets.each do |target|
    existing = target.shell_script_build_phases.find { |p| p.name == '[YourPods] Strip Extended Attributes' }
    unless existing
      phase = target.new_shell_script_build_phase('[YourPods] Strip Extended Attributes')
      phase.shell_script = 'find "${BUILT_PRODUCTS_DIR}" -name "*.framework" -exec xattr -cr {} \\; 2>/dev/null || true'
      phase.always_out_of_date = '1'  # Intentionally runs every build; suppress Xcode warning
    end
  end

  # Patch flutter_carplay FCPExtensions.swift to fix crash from force-unwrapping
  # optional URL and UIImage values in fromUrl(url:)
  fcp_ext = File.join(__dir__, '.symlinks', 'plugins', 'flutter_carplay', 'ios', 'Classes', 'FCPExtensions.swift')
  if File.exist?(fcp_ext)
    content = File.read(fcp_ext)
    patched = content
    # Fix 1: safe URL unwrapping — replace force-unwrap of url with guard-let
    patched = patched.sub(
      "let url = URL(string: url)\n      let data = try? Data(contentsOf: url!)",
      "guard let url = URL(string: url) else {\n          return UIImage(systemName: \"questionmark\")!\n      }\n      let data = try? Data(contentsOf: url)"
    )
    # Fix 2: safe UIImage creation — replace force-unwrap of UIImage(data:)
    patched = patched.sub(
      "return UIImage(data: data)!",
      "return UIImage(data: data) ?? UIImage(systemName: \"questionmark\")!"
    )
    if patched != content
      File.write(fcp_ext, patched)
      puts "[YourPods] Patched flutter_carplay FCPExtensions.swift (safe URL handling)"
    else
      puts "[YourPods] flutter_carplay FCPExtensions.swift already patched or changed upstream"
    end
  end
end
