    },
    "Log entries expire after 30 days. Tap Undo All to restore hidden episodes." : {
      "comment" : "Section footer under the auto-hide log. 'Undo All' is the button on each log row and must match that button's translation. A footer, so a full sentence is fine.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protokolleinträge verfallen nach 30 Tagen. Tippe auf „Alle einblenden“, um ausgeblendete Folgen wiederherzustellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las entradas del registro caducan a los 30 días. Toca Deshacer todo para restaurar los episodios ocultos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les entrées du journal expirent après 30 jours. Touchez Tout annuler pour réafficher les épisodes masqués."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le voci del registro scadono dopo 30 giorni. Tocca Ripristina tutto per mostrare di nuovo gli episodi nascosti."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vermeldingen in het logboek vervallen na 30 dagen. Tik op Toon alles om verborgen afleveringen weer zichtbaar te maken."
          }
        }
      }
    },
    "Manage Groups" : {
      "comment" : "Library menu item and the navigation title of the screen where groups are created, renamed, reordered and deleted. Groups are user-made folders of podcasts.",
