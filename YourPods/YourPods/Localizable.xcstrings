    "Security warning: This URL uses HTTP. Your credentials and data will be sent unencrypted. We recommend using HTTPS for security." : {
      "comment" : "VoiceOver label that repeats the on-screen warning shown when the typed server URL is unencrypted; the 'Security warning:' prefix exists so screen-reader users hear what the warning icon means. HTTP and HTTPS stay as they are.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sicherheitswarnung: Diese URL verwendet HTTP. Deine Zugangsdaten und Daten werden unverschlüsselt gesendet. Aus Sicherheitsgründen empfehlen wir HTTPS."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aviso de seguridad: esta URL usa HTTP. Tus credenciales y datos se enviarán sin cifrar. Te recomendamos usar HTTPS por seguridad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avertissement de sécurité : cette URL utilise HTTP. Vos identifiants et vos données seront envoyés sans chiffrement. Nous recommandons d'utiliser HTTPS pour plus de sécurité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avviso di sicurezza: questo URL usa HTTP. Le tue credenziali e i tuoi dati verranno inviati senza crittografia. Per sicurezza ti consigliamo di usare HTTPS."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beveiligingswaarschuwing: deze URL gebruikt HTTP. Je inloggegevens en overige gegevens worden onversleuteld verstuurd. We raden HTTPS aan voor de veiligheid."
          }
        }
      }
    },
    "See All" : {
      "comment" : "Link in the Home \"Recently Updated\" section header that opens the full list of all new episodes. Short header link.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle anzeigen"
          }
        },
        "es" : {
