        }
      }
    },
    "This will remove all episodes from your Up Next queue." : {
      "comment" : "Message of the clear-queue confirmation shown when nothing is currently playing. Up Next is the queue's screen name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit werden alle Folgen aus deiner Warteliste „Als Nächstes“ entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se quitarán todos los episodios de tu cola A continuación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
