    },
    "Search match. Double tap to seek." : {
      "comment" : "VoiceOver hint on a transcript line that matches the search but is not the currently selected result. 'Double tap' is the VoiceOver activation gesture; 'seek' means jump playback to that line's timecode. Heard, not read.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suchtreffer. Doppeltippen, um dorthin zu springen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coincidencia de búsqueda. Toca dos veces para saltar a ese punto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Résultat de recherche. Touchez deux fois pour lire à partir d'ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corrispondenza della ricerca. Tocca due volte per spostare la riproduzione."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoekresultaat. Dubbeltik om naar dit punt te gaan."
          }
        }
      }
    },
    "Search podcasts & episodes" : {
