      }
    },
    "Privacy Preserving Playback. Overrides your global P3 setting for this podcast. When on, tracking and ad-insertion redirects are removed from episode URLs." : {
      "comment" : "Section footer in one podcast's Listening Profile sheet explaining the P3 override. It opens with the expansion of P3 (a feature name), then explains that this setting replaces the app-wide one. 'When on' refers to the picker being set to On. A footer, so full sentences are fine.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datenschutzfreundliche Wiedergabe. Überschreibt für diesen Podcast deine globale P3-Einstellung. Wenn aktiviert, werden Tracking- und Werbe-Weiterleitungen aus den Folgen-URLs entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproducción con protección de la privacidad. Anula tu ajuste global de P3 para este podcast. Cuando está activada, se eliminan de las URL de los episodios los redireccionamientos de rastreo e inserción de anuncios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lecture préservant la confidentialité. Remplace votre réglage P3 global pour ce podcast. Lorsque cette option est activée, les redirections de suivi et d'insertion publicitaire sont supprimées des URL des épisodes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riproduzione che tutela la privacy. Sostituisce l'impostazione globale di P3 per questo podcast. Quando è attiva, i reindirizzamenti di tracciamento e di inserimento pubblicitario vengono rimossi dagli URL degli episodi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privacybeschermend afspelen. Vervangt voor deze podcast je algemene P3-instelling. Wanneer dit aanstaat, worden omleidingen voor tracking en advertenties uit de URL's van afleveringen verwijderd."
          }
        }
      }
    },
    "Processing podcast %lld of %lld…" : {
      "comment" : "Progress line in the auto-hide sheet while the library is being scanned. Argument 1 is the number of the podcast currently being processed, argument 2 the total number of podcasts. Ends with an ellipsis to signal work in progress.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
