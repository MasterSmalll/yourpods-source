            "state" : "translated",
            "value" : "you@example.com"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "you@example.com"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "you@example.com"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "you@example.com"
          }
        }
      }
    },
    "Your account is free. No payment required." : {
      "comment" : "Reassurance under the YourPods Sync sign-up form. 'Free' here means costing nothing — a price, not availability.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Account ist kostenlos. Keine Zahlung erforderlich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuenta es gratuita. No hace falta pagar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre compte est gratuit. Aucun paiement requis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo account è gratuito. Nessun pagamento richiesto."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je account is gratis. Je hoeft niets te betalen."
          }
        }
      }
    },
    "Your Data & Privacy" : {
      "comment" : "Navigation title of the data-transparency screen, and the label of the row that opens it from the About Account Types screen. The ampersand may become the local 'and' word; navigation titles have little width.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Daten & Privatsphäre"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus datos y privacidad"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos données et confidentialité"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dati e privacy"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je gegevens en privacy"
          }
        }
      }
    },
    "Your data, your server, your rules." : {
      "comment" : "Short one-line summary of the Nextcloud / Self-Hosted option, shown as a caption. Rhythmic three-part phrase; keep it punchy.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Daten, dein Server, deine Regeln."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus datos, tu servidor, tus reglas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos données, votre serveur, vos règles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi dati, il tuo server, le tue regole."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jouw data, jouw server, jouw regels."
          }
        }
      }
    },
    "Your device and server have different playback positions for these episodes. Choose which position to keep." : {
      "comment" : "Intro text above the position conflicts in the Sync Conflicts sheet. 'Position' means how far into an episode playback had reached.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerät und Server haben für diese Folgen unterschiedliche Wiedergabepositionen. Wähle aus, welche Position behalten werden soll."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu dispositivo y el servidor tienen posiciones de reproducción distintas para estos episodios. Elige qué posición quieres conservar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre appareil et le serveur ont des positions de lecture différentes pour ces épisodes. Choisissez la position à conserver."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il dispositivo e il server hanno posizioni di riproduzione diverse per questi episodi. Scegli quale posizione mantenere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je apparaat en de server hebben verschillende afspeelposities voor deze afleveringen. Kies welke positie je wilt behouden."
          }
        }
      }
    },
    "Your device never contacts tracking servers — not even a single request. The URL is cleaned locally on your device before playback begins." : {
      "comment" : "P3 explanation detail. 'cleaned locally' = tracking parts stripped on-device before playing.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Gerät kontaktiert niemals Tracking-Server – nicht eine einzige Anfrage. Die URL wird lokal auf deinem Gerät bereinigt, bevor die Wiedergabe beginnt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu dispositivo nunca se comunica con servidores de rastreo, ni siquiera con una sola petición. La URL se limpia localmente en tu dispositivo antes de empezar la reproducción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre appareil ne contacte jamais les serveurs de suivi — pas une seule requête. L'URL est nettoyée localement sur votre appareil avant le début de la lecture."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo dispositivo non contatta mai i server di tracciamento — nemmeno una singola richiesta. L'URL viene ripulito localmente sul tuo dispositivo prima dell'inizio della riproduzione."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je apparaat neemt nooit contact op met trackingservers — zelfs geen enkel verzoek. De URL wordt lokaal op je apparaat opgeschoond voordat het afspelen begint."
          }
        }
      }
    },
    "Your free account is ready.\nPro unlocks extra features and supports continued development." : {
      "comment" : "Two-line subheading under the 'YourPods Pro' title at the top of the paywall, usually seen right after signing up. The literal line break between the sentences must be kept. 'free account' is the unpaid tier of the service and 'Pro' is the paid tier's product name, which is never translated.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein kostenloser Account ist bereit.\nPro schaltet zusätzliche Funktionen frei und unterstützt die Weiterentwicklung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuenta gratuita está lista.\nPro desbloquea funciones extra y ayuda a mantener el desarrollo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre compte gratuit est prêt.\nPro débloque des fonctionnalités supplémentaires et soutient le développement continu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo account gratuito è pronto.\nPro sblocca funzioni extra e sostiene lo sviluppo continuo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je gratis account is klaar.\nPro ontgrendelt extra functies en steunt de verdere ontwikkeling."
          }
        }
      }
    },
    "Your listening stats will appear here once you've synced with YourPods Sync." : {
      "comment" : "Explanatory text of the empty state on the listening-stats screen, under the title 'No Stats Yet'. 'YourPods Sync' is the name of the account/sync service and is never translated; 'synced' means completing a synchronization with it.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Hörstatistiken erscheinen hier, sobald du mit YourPods Sync synchronisiert hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus estadísticas de escucha aparecerán aquí cuando hayas sincronizado con YourPods Sync."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos statistiques d'écoute apparaîtront ici une fois la synchronisation avec YourPods Sync effectuée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tue statistiche di ascolto appariranno qui dopo la prima sincronizzazione con YourPods Sync."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je luisterstatistieken verschijnen hier zodra je met YourPods Sync hebt gesynchroniseerd."
          }
        }
      }
    },
    "Your local podcasts and listening history will be migrated to YourPods Sync." : {
      "comment" : "Footer under the Vault-to-YourPods-Sync promotion form. 'Local' means held on this device only; 'migrated' means copied up into the account.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine lokalen Podcasts und dein Hörverlauf werden zu YourPods Sync übertragen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus podcasts locales y tu historial de escucha se migrarán a YourPods Sync."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos podcasts locaux et votre historique d'écoute seront transférés vers YourPods Sync."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi podcast locali e la cronologia di ascolto verranno migrati su YourPods Sync."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je lokale podcasts en luistergeschiedenis worden overgezet naar YourPods Sync."
          }
        }
      }
    },
    "Your local podcasts will be pushed to the server. Server podcasts will be merged into your library." : {
      "comment" : "Footer under the Vault-to-gPodder promotion form, describing the two-way merge that happens on connecting.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine lokalen Podcasts werden auf den Server übertragen. Podcasts vom Server werden in deine Mediathek übernommen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus podcasts locales se enviarán al servidor. Los podcasts del servidor se combinarán con tu biblioteca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos podcasts locaux seront envoyés vers le serveur. Les podcasts du serveur seront fusionnés dans votre bibliothèque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi podcast locali verranno inviati al server. I podcast presenti sul server verranno uniti alla tua libreria."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je lokale podcasts worden naar de server gestuurd. Podcasts van de server worden samengevoegd met je bibliotheek."
          }
        }
      }
    },
    "Your own server — you control the data" : {
      "comment" : "Feature bullet for the Nextcloud / Self-Hosted card. The user runs the server themselves.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein eigener Server – du kontrollierst die Daten"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu propio servidor: tú controlas los datos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre propre serveur — vous contrôlez les données"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo server — controlli tu i dati"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je eigen server — jij beheert je data"
          }
        }
      }
    },
    "Your password has been changed. Please sign in again with your new password." : {
      "comment" : "Body of the alert shown after a successful password change; the server has already signed the user out on every device.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Passwort wurde geändert. Bitte melde dich mit deinem neuen Passwort erneut an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu contraseña se ha cambiado. Vuelve a iniciar sesión con la nueva contraseña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre mot de passe a été modifié. Veuillez vous reconnecter avec votre nouveau mot de passe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua password è stata modificata. Accedi di nuovo con la nuova password."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je wachtwoord is gewijzigd. Log opnieuw in met je nieuwe wachtwoord."
          }
        }
      }
    },
    "Your played episodes will appear here after syncing." : {
      "comment" : "Explanatory text of the empty state shown on the listening-stats screen when the episode-activity list is empty, under the title 'No Episode Activity'. 'played episodes' means episodes the user has listened to; 'syncing' means synchronizing with the YourPods server.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine gespielten Folgen erscheinen hier nach der Synchronisierung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus episodios reproducidos aparecerán aquí después de sincronizar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos épisodes lus apparaîtront ici après la synchronisation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli episodi che hai riprodotto appariranno qui dopo la sincronizzazione."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je afgespeelde afleveringen verschijnen hier na het synchroniseren."
          }
        }
      }
    },
    "Your podcasts stay entirely on your device. No servers, no accounts, no data leaves your phone. Just install and listen." : {
      "comment" : "Body paragraph describing Vault Mode on the About Account Types screen.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Podcasts bleiben vollständig auf deinem Gerät. Keine Server, keine Accounts, keine Daten verlassen dein Telefon. Einfach installieren und hören."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus podcasts se quedan íntegramente en tu dispositivo. Sin servidores, sin cuentas y sin que ningún dato salga de tu teléfono. Solo tienes que instalar la app y escuchar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos podcasts restent entièrement sur votre appareil. Aucun serveur, aucun compte, aucune donnée ne quitte votre téléphone. Installez et écoutez, c'est tout."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi podcast restano interamente sul tuo dispositivo. Nessun server, nessun account, nessun dato lascia il tuo telefono. Ti basta installare e ascoltare."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je podcasts blijven volledig op je apparaat. Geen servers, geen accounts, geen gegevens die je telefoon verlaten. Gewoon installeren en luisteren."
          }
        }
      }
    },
    "Your Profiles" : {
      "comment" : "Header of the section listing the account entries already configured on this device.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Profile"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus perfiles"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos profils"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi profili"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je profielen"
          }
        }
      }
    },
    "Your subscription directly funds development, keeps the servers running, and ensures YourPods stays independent and open source." : {
      "comment" : "Caption under the YourPods Pro description on the About Account Types screen. 'Subscription' here means the paid Pro plan, NOT a podcast subscription — keep the two senses clearly distinct in your language.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Pro-Abo finanziert direkt die Entwicklung, hält die Server am Laufen und sorgt dafür, dass YourPods unabhängig und Open Source bleibt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu suscripción financia directamente el desarrollo, mantiene los servidores en marcha y garantiza que YourPods siga siendo independiente y de código abierto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre abonnement finance directement le développement, maintient les serveurs en fonctionnement et garantit que YourPods reste indépendant et open source."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo abbonamento finanzia direttamente lo sviluppo, mantiene attivi i server e garantisce che YourPods resti indipendente e open source."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je abonnement financiert de ontwikkeling rechtstreeks, houdt de servers draaiende en zorgt ervoor dat YourPods onafhankelijk en open source blijft."
          }
        }
      }
    },
    "YourPods" : {
      "comment" : "The app's own name — never translate or transliterate it. It appears as the Home screen navigation title, beside the logo in the toolbar, and as fallback text on the Apple Watch complication.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YourPods"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YourPods"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YourPods"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YourPods"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YourPods"
          }
        }
      }
    },
    "YourPods adds actions to the Shortcuts app — playback controls, downloads, bookmarks, and building blocks like Get Current Episode that return values you can use in your own automations." : {
      "comment" : "Intro paragraph on the Siri & Shortcuts settings screen. 'Shortcuts' is Apple's app name; 'Get Current Episode' is the name of one of this app's Shortcuts actions and must match that action's own translation. 'Building blocks' means actions meant to be combined in the user's own automations.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YourPods fügt der Kurzbefehle-App Aktionen hinzu – Wiedergabesteuerung, Downloads, Lesezeichen und Bausteine wie Aktuelle Folge abrufen, die Werte zurückgeben, die du in deinen eigenen Automationen verwenden kannst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YourPods añade acciones a la app Atajos — controles de reproducción, descargas, marcadores y bloques como Obtener el episodio actual que devuelven valores que puedes usar en tus propias automatizaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YourPods ajoute des actions à l'app Raccourcis — commandes de lecture, téléchargements, signets et briques de base comme Obtenir l'épisode en cours, qui fournissent des valeurs utilisables dans vos propres automatisations."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YourPods aggiunge azioni all'app Comandi rapidi — controlli di riproduzione, download, segnalibri e blocchi di base come Ottieni l'episodio attuale, che restituiscono valori da usare nelle tue automazioni."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YourPods voegt acties toe aan de Opdrachten-app — afspeelbediening, downloads, bladwijzers en bouwstenen zoals Haal huidige aflevering op, die waarden teruggeven die je in je eigen automatiseringen kunt gebruiken."
          }
        }
      }
    },
    "YourPods app icon" : {
      "comment" : "VoiceOver label for the app logo image on the welcome page. Spoken, not read.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App-Symbol von YourPods"
          }
        },
        "es" : {
