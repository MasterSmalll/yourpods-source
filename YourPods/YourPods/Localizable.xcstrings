    "Future position conflicts will be resolved the same way, without asking." : {
      "comment" : "Footer under the 'Always use this choice' toggle in the Sync Conflicts sheet, explaining what turning it on does. One short sentence, room for a full clause.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Künftige Positionskonflikte werden ohne Nachfrage genauso gelöst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los futuros conflictos de posición se resolverán del mismo modo, sin preguntar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les futurs conflits de position seront résolus de la même manière, sans vous demander."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I futuri conflitti di posizione verranno risolti allo stesso modo, senza chiedere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toekomstige positieconflicten worden op dezelfde manier opgelost, zonder te vragen."
          }
        }
      }
    },
    "Get a local notification when new episodes are discovered. Requires notifications to be enabled in Settings → Background Refresh." : {
      "comment" : "Section footer in one podcast's Listening Profile sheet explaining the per-podcast notification switch. 'Settings -> Background Refresh' is a navigation path whose names must match their own translations. A footer, so full sentences are fine.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhalte eine lokale Mitteilung, wenn neue Folgen gefunden werden. Dazu müssen Mitteilungen unter Einstellungen → Hintergrundaktualisierung aktiviert sein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recibe una notificación local cuando se encuentren episodios nuevos. Requiere que las notificaciones estén activadas en Ajustes → Actualización en segundo plano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recevez une notification locale lorsque de nouveaux épisodes sont détectés. Les notifications doivent être activées dans Réglages → Actualisation en arrière-plan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricevi una notifica locale quando vengono trovati nuovi episodi. Richiede che le notifiche siano attive in Impostazioni → Aggiornamento in background."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ontvang een melding op dit apparaat wanneer er nieuwe afleveringen worden gevonden. Hiervoor moeten meldingen zijn ingeschakeld bij Instellingen → Ververs op achtergrond."
          }
        }
      }
    },
    "Get a share link for the current moment" : {
