        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I progressi di ascolto degli episodi dal tuo server gPodder appariranno qui dopo la sincronizzazione."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De luistervoortgang van afleveringen op je gPodder-server verschijnt hier na het synchroniseren."
          }
        }
      }
    },
    "Episode Swipe Actions" : {
      "comment" : "Section header over the two pickers that bind an action to swiping an episode row left or right. Translate in normal case — iOS applies capitalisation styling itself.",
      "localizations" : {
