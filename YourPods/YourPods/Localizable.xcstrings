    "We do not collect analytics, tracking data, or ad identifiers. Nothing above is used to profile you or shared with anyone." : {
      "comment" : "Body sentence on the data-transparency screen. The first sentence is a flat denial of three distinct things: 'analytics', 'tracking data' and 'ad identifiers'. 'Nothing above' refers to the list of stored data shown directly above this line.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir erfassen keine Analysedaten, Tracking-Daten und keine Werbe-IDs. Nichts davon wird genutzt, um ein Profil von dir zu erstellen, und nichts wird weitergegeben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No recopilamos analíticas, datos de seguimiento ni identificadores publicitarios. Nada de lo anterior se usa para crear un perfil tuyo ni se comparte con nadie."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous ne collectons aucune donnée d'analyse, aucune donnée de suivi et aucun identifiant publicitaire. Rien de ce qui précède ne sert à vous profiler ni n'est partagé avec qui que ce soit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non raccogliamo dati analitici, dati di tracciamento né identificatori pubblicitari. Nulla di quanto sopra viene usato per profilarti o condiviso con altri."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We verzamelen geen analysegegevens, trackinggegevens of advertentie-ID's. Niets hiervan wordt gebruikt om een profiel van je op te bouwen of met anderen gedeeld."
          }
        }
      }
    },
    "Web player" : {
      "comment" : "Name of one feature in the Free-vs-Pro comparison table on the paywall; Pro only. It refers to playing podcasts in a browser on the YourPods website, as opposed to the app. Keep it short — the feature-name column is narrow.",
