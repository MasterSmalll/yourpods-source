        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'aggiornamento con il trascinamento verso il basso ignora la cache e recupera dati aggiornati."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omlaag trekken om te vernieuwen negeert de cache en haalt nieuwe gegevens op."
          }
        }
      }
    },
