          }
        }
      }
    },
    "YourPods Cloud" : {
      "comment" : "Small purple header grouping the two hosted account types (Free and Pro) on the onboarding chooser, plus its VoiceOver label. A product name — never translated.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YourPods Cloud"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YourPods Cloud"
          }
        },
        "fr" : {
          "stringUnit" : {
