    "Returns the podcasts you follow." : {
      "comment" : "Help sentence shown under the action name 'Get Podcasts' in the Shortcuts app. 'Podcasts' = shows, not episodes; 'follow' is this app's word for subscribing to a show.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
