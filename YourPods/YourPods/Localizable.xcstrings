    "For servers that don't support Login Flow, create an app password in Nextcloud → Settings → Security." : {
      "comment" : "Footer explaining the manual fallback for older Nextcloud servers. 'Login Flow' is Nextcloud's browser sign-in feature and 'Settings → Security' is a path through Nextcloud's own interface — use the names Nextcloud itself uses in your language, and keep the arrow.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für Server ohne Unterstützung für Login Flow erstellst du ein App-Passwort in Nextcloud → Einstellungen → Sicherheit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En los servidores que no admiten Login Flow, crea una contraseña de aplicación en Nextcloud → Configuración → Seguridad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour les serveurs qui ne prennent pas en charge Login Flow, créez un mot de passe d'application dans Nextcloud → Paramètres → Sécurité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per i server che non supportano Login Flow, crea una password dell'app in Nextcloud → Impostazioni → Sicurezza."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor servers die Login Flow niet ondersteunen: maak een app-wachtwoord aan in Nextcloud → Instellingen → Beveiliging."
          }
        }
      }
    },
    "Force Pull from Server" : {
      "comment" : "Button in Settings that forces a full download of the server's state, overwriting local data. 'Pull' is the verb 'to fetch down from the server'; 'Force' means do it now regardless of timers. A settings row with a spinner beside it, so keep it reasonably short.",
