            "value" : "Voeg toe"
          }
        }
      }
    },
    "Add %@ to Queue" : {
      "comment" : "VoiceOver label for the button that adds a shared podcast's episode to the Up Next queue. Argument 1 is the episode title — user content from the feed, never translated.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ zur Warteliste hinzufügen"
          }
        },
