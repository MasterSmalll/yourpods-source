    },
    "Loading stats…" : {
      "comment" : "Visible text beside the spinner on the listening-stats screen while the data is being fetched. 'stats' is the short form of statistics; the trailing character is a single ellipsis (…), not three periods, and should be kept.",
      "localizations" : {
        "de" : {
