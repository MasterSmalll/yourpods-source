    "About" : {
      "comment" : "Section header used twice: in the podcast preview sheet it introduces the show's description text, and in Settings it heads the app version and build rows. Header only, no verb — the sense is 'about this show' / 'about this app'.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Info"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Información"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À propos"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informazioni"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Over"
          }
        }
      }
    },
    "About Account Types" : {
      "comment" : "Settings row that opens an explanatory screen, and that screen's navigation title. 'Account Types' means the available sync modes (Vault, self-hosted gPodder, third-party gPodder, YourPods Free, YourPods Pro) — not user accounts in the login sense. Navigation titles have little width, so keep it compact.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Info zu Account-Typen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tipos de cuenta"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Types de compte"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tipi di account"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Over accounttypen"
          }
        }
      }
    },
    "About these translations" : {
      "comment" : "Title of the sheet shown once, on first launch, to users whose device language is not English. It introduces an admission that the app's translations are machine-made, so the tone is plain and unembarrassed — not an apology, not marketing. THIS SHEET IS THE APP'S FIRST IMPRESSION IN YOUR LANGUAGE; translate it with more care than anything else in the app.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Über diese Übersetzungen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sobre estas traducciones"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À propos de ces traductions"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informazioni su queste traduzioni"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Over deze vertalingen"
          }
        }
      }
    },
    "About This Episode" : {
      "comment" : "Section heading above the episode's description text in the episode detail sheet. 'Episode' is one installment of a podcast show.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Über diese Folge"
