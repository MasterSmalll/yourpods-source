        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies wat er gebeurt als je over een aflevering veegt. Geldt voor alle afleveringslijsten in de app."
          }
        }
      }
    },
    "Choose Your Setup" : {
