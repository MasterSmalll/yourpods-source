    "Loading listening stats" : {
      "comment" : "VoiceOver label for the progress spinner shown while listening statistics are being fetched. Heard rather than read; it describes the state of the screen, so a present-progressive phrasing is intended.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hörstatistik wird geladen"
