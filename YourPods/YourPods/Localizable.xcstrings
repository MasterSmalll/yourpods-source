    "A minimal record (hashed email + deletion date) is retained for 3 years per legal requirements." : {
      "comment" : "Fine print inside the red 'Danger Zone' block that appears when the user opens the permanent account-deletion form for a YourPods Sync account; it states what the server keeps after everything else is destroyed. Legal wording — stay precise.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein minimaler Datensatz (gehashte E-Mail-Adresse + Löschdatum) wird aus rechtlichen Gründen 3 Jahre lang aufbewahrt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se conserva un registro mínimo (correo electrónico con hash + fecha de eliminación) durante 3 años por requisitos legales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un enregistrement minimal (adresse e-mail hachée + date de suppression) est conservé pendant 3 ans conformément aux obligations légales."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per obblighi di legge viene conservato un record minimo (email sottoposta a hash + data di eliminazione) per 3 anni."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een minimale registratie (gehasht e-mailadres + verwijderdatum) wordt volgens wettelijke verplichtingen 3 jaar bewaard."
          }
        }
      }
    },
