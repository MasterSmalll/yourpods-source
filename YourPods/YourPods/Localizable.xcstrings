            "value" : "YourPods Cloud"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YourPods Cloud"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YourPods Cloud"
          }
        }
      }
    },
    "YourPods collects no data when used without a YourPods Sync account. In Vault Mode, everything stays on your device — nothing is sent anywhere." : {
      "comment" : "Body paragraph on the data-transparency screen. 'YourPods' and 'YourPods Sync' are product names and are never translated; 'Vault Mode' is the app's name for using it purely locally with no sync account, so match the translation of Vault used elsewhere.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YourPods erfasst keine Daten, wenn du es ohne YourPods Sync-Account nutzt. Im Tresor-Modus bleibt alles auf deinem Gerät – nichts wird irgendwohin gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YourPods no recopila ningún dato cuando se usa sin una cuenta de YourPods Sync. En el Modo Privado, todo se queda en tu dispositivo — no se envía nada a ninguna parte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YourPods ne collecte aucune donnée lorsqu'il est utilisé sans compte YourPods Sync. En mode Coffre-fort, tout reste sur votre appareil — rien n'est envoyé nulle part."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YourPods non raccoglie alcun dato quando viene usata senza un account YourPods Sync. In Modalità Cassaforte tutto resta sul tuo dispositivo — non viene inviato nulla all'esterno."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YourPods verzamelt geen gegevens als je het zonder YourPods Sync-account gebruikt. In Kluismodus blijft alles op je apparaat — er wordt niets verstuurd."
          }
        }
      }
    },
    "YourPods Free Sync" : {
      "comment" : "Title of the free YourPods cloud account type on the onboarding chooser, and the Settings account-section header for a free cloud user. 'YourPods' is the product name — never translate. 'Free' and 'Sync' may be translated.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YourPods Free Sync"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YourPods Sincronización gratis"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YourPods Sync gratuite"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YourPods Sync gratuita"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YourPods gratis synchronisatie"
          }
        }
      }
    },
    "YourPods is written in English. We use AI as part of the development process to translate it into other languages, so some wording might be a bit off." : {
      "comment" : "The disclosure itself, shown on the first-run sheet and again permanently in Settings → Language & Translation. Must stay accurate on one point: AI translates the app WHILE IT IS BEING BUILT — it does not translate anything for the user at runtime, and no user text is sent anywhere. 'A bit off' is deliberately mild and honest; do not escalate it to 'wrong' or soften it to 'may vary'. YourPods is the product name and is never translated.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YourPods ist auf Englisch geschrieben. Wir setzen bei der Entwicklung KI ein, um die App in andere Sprachen zu übersetzen – manche Formulierung ist deshalb vielleicht nicht ganz treffend."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YourPods está escrito en inglés. Usamos IA durante el proceso de desarrollo para traducirlo a otros idiomas, así que puede que alguna expresión no suene del todo bien."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YourPods est écrit en anglais. Nous utilisons l'IA dans le cadre du processus de développement pour le traduire dans d'autres langues, donc certaines formulations ne sont peut-être pas tout à fait justes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YourPods è scritta in inglese. Usiamo l'IA nel processo di sviluppo per tradurla in altre lingue, quindi qualche espressione potrebbe suonare un po' strana."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YourPods is in het Engels geschreven. We gebruiken AI tijdens het ontwikkelproces om de app in andere talen te vertalen, dus sommige formuleringen zijn misschien net niet helemaal raak."
          }
        }
      }
    },
