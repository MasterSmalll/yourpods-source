    },
    "Everything stays on-device. Maximum privacy, zero setup." : {
      "comment" : "Short one-line summary of Vault Mode, shown as a caption in the profile/account picker rows.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles bleibt auf dem Gerät. Maximaler Datenschutz, keine Einrichtung."
