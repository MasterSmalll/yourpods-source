    "Episode Details" : {
      "comment" : "Navigation title of the sheet showing one episode's description, badges and actions, and the mini-player overflow-menu item that opens it.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folgendetails"
