            "state" : "translated",
            "value" : "Afleveringsdetails"
          }
        }
      }
    },
    "Episode listening progress from your gPodder server will appear here after syncing." : {
      "comment" : "Explanatory text of the empty state on the episode-activity screen for gPodder accounts, shown under the title 'No Episode Activity' when no records have arrived yet. gPodder is a product name and is never translated; 'syncing' means synchronizing with that server.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Hörfortschritt der Folgen von deinem gPodder-Server erscheint hier nach der Synchronisierung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El progreso de escucha de los episodios de tu servidor gPodder aparecerá aquí después de sincronizar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La progression d'écoute des épisodes de votre serveur gPodder apparaîtra ici après la synchronisation."
