    "Download every episode currently in your queue." : {
      "comment" : "Help sentence shown under the action name 'Download My Queue' in the Shortcuts app. Queue = the ordered list of episodes to play; download means store the audio on device for offline listening.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lädt jede Folge herunter, die sich aktuell in deiner Warteliste befindet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarga todos los episodios que haya en tu cola."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Télécharge tous les épisodes actuellement dans votre file d'attente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scarica tutti gli episodi presenti nella tua coda."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download elke aflevering die nu in je wachtrij staat."
          }
        }
      }
    },
    "Download Latest Episode" : {
