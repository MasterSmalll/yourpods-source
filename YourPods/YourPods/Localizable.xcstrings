    "Opens your Nextcloud login page in a browser. Your credentials stay in the browser, never in this app." : {
      "comment" : "Caption under the 'Sign in with Nextcloud' button in onboarding, reassuring the user that the password is typed into Nextcloud's page and never into YourPods.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet deine Nextcloud-Anmeldeseite in einem Browser. Deine Zugangsdaten bleiben im Browser und landen nie in dieser App."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre la página de inicio de sesión de Nextcloud en el navegador. Tus credenciales se quedan en el navegador, nunca en esta app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvre votre page de connexion Nextcloud dans un navigateur. Vos identifiants restent dans le navigateur, jamais dans cette app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apre la pagina di accesso Nextcloud in un browser. Le tue credenziali restano nel browser, mai in questa app."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opent je Nextcloud-inlogpagina in een browser. Je inloggegevens blijven in de browser en komen nooit in deze app."
          }
        }
      }
    },
    "Opens your Nextcloud server in a browser. Log in and grant access — your credentials stay in the browser, never in this app." : {
      "comment" : "Section footer under the same Nextcloud sign-in button in the add-account sheet. 'Grant access' refers to the approval step on Nextcloud's own web page.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet deinen Nextcloud-Server in einem Browser. Melde dich an und erteile den Zugriff – deine Zugangsdaten bleiben im Browser und landen nie in dieser App."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre tu servidor de Nextcloud en el navegador. Inicia sesión y concede el acceso: tus credenciales se quedan en el navegador, nunca en esta app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvre votre serveur Nextcloud dans un navigateur. Connectez-vous et accordez l'accès — vos identifiants restent dans le navigateur, jamais dans cette app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apre il tuo server Nextcloud in un browser. Accedi e concedi l'autorizzazione: le tue credenziali restano nel browser, mai in questa app."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opent je Nextcloud-server in een browser. Log in en geef toegang — je inloggegevens blijven in de browser en komen nooit in deze app."
          }
        }
      }
    },
    "Opens yourpods.app/p3 in Safari" : {
      "comment" : "VoiceOver hint on the 'Learn More' link on the P3 screen — heard, not read. The URL stays exactly as written and Safari is Apple's browser name.",
      "localizations" : {
        "de" : {
