    },
    "Credentials are stored securely in your device's Keychain and are never synced to any server." : {
      "comment" : "Section footer in one podcast's Listening Profile sheet, under the fields for a password-protected RSS feed. 'Keychain' is Apple's system credential store — use Apple's name for it in this language.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zugangsdaten werden sicher im Schlüsselbund deines Geräts gespeichert und niemals mit einem Server synchronisiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las credenciales se guardan de forma segura en el Llavero de tu dispositivo y nunca se sincronizan con ningún servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les identifiants sont stockés de manière sécurisée dans le Trousseau de votre appareil et ne sont jamais synchronisés vers un serveur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le credenziali vengono salvate in modo sicuro nel Portachiavi del tuo dispositivo e non vengono mai sincronizzate con nessun server."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inloggegevens worden veilig bewaard in de Sleutelhanger van je apparaat en worden nooit met een server gesynchroniseerd."
          }
        }
      }
    },
    "Credentials stored securely on this device only — not synced to any server." : {
      "comment" : "Reassurance shown next to a lock icon after a protected feed is successfully added: the username and password are kept in this device's keychain and are never uploaded. Small caption text.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zugangsdaten werden sicher nur auf diesem Gerät gespeichert – nicht mit einem Server synchronisiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Credenciales guardadas de forma segura solo en este dispositivo; no se sincronizan con ningún servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identifiants stockés de manière sécurisée sur cet appareil uniquement — jamais synchronisés vers un serveur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
