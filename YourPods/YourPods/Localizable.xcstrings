    },
    "Text Only" : {
      "comment" : "Picker option for the tab bar style: show only the text labels, without icons. Sits in a segmented row next to 'Icon Only' and 'Text & Icon', so it must stay very short.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
