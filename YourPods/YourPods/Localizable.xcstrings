    "Maximum privacy, zero setup. You can convert a Vault profile to any sync mode anytime without losing your data." : {
      "comment" : "Secondary caption under the Vault Mode description on the About Account Types screen. 'Vault profile' means a profile in the local-only mode — keep the product name consistent with the other Vault strings.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximale Privatsphäre, keine Einrichtung. Du kannst ein Tresor-Profil jederzeit in einen beliebigen Sync-Modus umwandeln, ohne Daten zu verlieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máxima privacidad, cero configuración. Puedes convertir un perfil en Modo Privado a cualquier modo de sincronización cuando quieras sin perder tus datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confidentialité maximale, aucune configuration. Vous pouvez convertir un profil Coffre-fort en n'importe quel mode de synchronisation à tout moment, sans perdre vos données."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Massima privacy, zero configurazione. Puoi convertire un profilo Cassaforte in qualsiasi modalità di sincronizzazione in qualunque momento senza perdere i tuoi dati."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximale privacy, geen configuratie. Je kunt een Kluisprofiel altijd omzetten naar elke synchronisatiemodus zonder je gegevens te verliezen."
          }
        }
      }
    },
    "Media proxy" : {
      "comment" : "Name of one feature in the Free-vs-Pro comparison table on the paywall; Pro only. It refers to the YourPods server relaying podcast audio and images on the user's behalf. 'Proxy' is the networking sense (an intermediary server), not a person acting for another. Keep it short — the column is narrow.",
