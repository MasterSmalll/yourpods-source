            "value" : "%lld min"
          }
        }
      }
    },
    "%lld min this week" : {
      "comment" : "Subtitle line under the Listening Stats item when Siri or the Shortcuts app shows the stats result. %lld is how many minutes the user listened in the last seven days. 'min' is the abbreviation of 'minutes' — keep it abbreviated, the subtitle is one narrow line, and there are no plural rules, so choose a form that reads correctly for any count including 1.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld Min. diese Woche"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld min esta semana"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld min cette semaine"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld min questa settimana"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld min deze week"
          }
        }
      }
    },
    "%lld of %lld" : {
      "comment" : "Search-result counter in the toolbar of the transcript sheet, e.g. '3 of 12'. Argument 1 is the 1-based index of the transcript line currently highlighted, argument 2 the total number of matching lines. Sits between two tiny chevron buttons, so it must stay very short.",
