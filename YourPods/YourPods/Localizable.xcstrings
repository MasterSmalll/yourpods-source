    "Resume playback or start playing your queue." : {
      "comment" : "Help sentence shown under the action name 'Play My Queue' in the Shortcuts app: it continues a paused episode, or starts the queue (the ordered list of episodes to play) if nothing is loaded.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
