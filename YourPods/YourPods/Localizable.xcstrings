              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Damit wird %1$lld heruntergeladene Folge entfernt und %2$@ Speicherplatz freigegeben."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
