        }
      }
    },
    "What's Playing" : {
      "comment" : "Used twice: the intent TITLE in the Shortcuts action list AND the short tile name for the ready-made shortcut, so it must stay short. Phrased as a question in English — which episode is playing right now.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was läuft gerade"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qué suena ahora"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lecture en cours"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cosa è in riproduzione"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wat speelt er nu"
          }
        }
      }
    },
    "When adding a new podcast, hide all but the %lld most recent episodes. Unhide anytime via Show Hidden in the podcast detail." : {
      "comment" : "Section footer in Settings -> New Podcast Defaults, shown while 'Auto-Hide Old Episodes' is on. Plural rules handle the count; it counts the most recent episodes that stay visible. 'Show Hidden' is a command in the podcast detail screen and must match its translation.",
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Beim Hinzufügen eines neuen Podcasts werden alle Folgen bis auf die neueste ausgeblendet. Du kannst sie jederzeit über „Ausgeblendete anzeigen“ in der Podcast-Ansicht wieder einblenden."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Beim Hinzufügen eines neuen Podcasts werden alle Folgen bis auf die %lld neuesten ausgeblendet. Du kannst sie jederzeit über „Ausgeblendete anzeigen“ in der Podcast-Ansicht wieder einblenden."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "When adding a new podcast, hide all but the most recent episode. Unhide anytime via Show Hidden in the podcast detail."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "When adding a new podcast, hide all but the %lld most recent episodes. Unhide anytime via Show Hidden in the podcast detail."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Al añadir un podcast nuevo, se ocultarán todos los episodios excepto el más reciente. Puedes volver a mostrarlos cuando quieras con Mostrar ocultos en el detalle del podcast."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Al añadir un podcast nuevo, se ocultarán todos los episodios excepto los %lld más recientes. Puedes volver a mostrarlos cuando quieras con Mostrar ocultos en el detalle del podcast."
                }
              }
            }
          }
        },
        "fr" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Lors de l'ajout d'un nouveau podcast, masquer tous les épisodes sauf le plus récent. Vous pourrez les réafficher à tout moment via Afficher les masqués dans la fiche du podcast."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Lors de l'ajout d'un nouveau podcast, masquer tous les épisodes sauf les %lld plus récents. Vous pourrez les réafficher à tout moment via Afficher les masqués dans la fiche du podcast."
                }
              }
            }
          }
        },
        "it" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Quando aggiungi un nuovo podcast, verranno nascosti tutti gli episodi tranne il più recente. Puoi mostrarli di nuovo in qualsiasi momento con Mostra nascosti nella scheda del podcast."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Quando aggiungi un nuovo podcast, verranno nascosti tutti gli episodi tranne i %lld più recenti. Puoi mostrarli di nuovo in qualsiasi momento con Mostra nascosti nella scheda del podcast."
                }
              }
            }
          }
        },
        "nl" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Verberg bij het toevoegen van een nieuwe podcast alles behalve de nieuwste aflevering. Je kunt afleveringen altijd weer zichtbaar maken via Toon verborgen in het detailscherm van de podcast."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Verberg bij het toevoegen van een nieuwe podcast alles behalve de %lld nieuwste afleveringen. Je kunt afleveringen altijd weer zichtbaar maken via Toon verborgen in het detailscherm van de podcast."
                }
              }
            }
          }
        }
      }
    },
    "When enabled, hides all but the most recent episodes when you subscribe to a new podcast" : {
      "comment" : "VoiceOver hint on the Auto-Hide Old Episodes toggle — heard, not read. Explains what happens the next time the user subscribes to a podcast.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blendet beim Abonnieren eines neuen Podcasts alle Folgen bis auf die neuesten aus"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, oculta todos los episodios excepto los más recientes al suscribirte a un podcast nuevo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque cette option est activée, masque tous les épisodes sauf les plus récents quand vous vous abonnez à un nouveau podcast"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se attivo, quando ti iscrivi a un nuovo podcast nasconde tutti gli episodi tranne i più recenti"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als dit aanstaat, worden bij het abonneren op een nieuwe podcast alle afleveringen behalve de nieuwste verborgen"
          }
        }
      }
    },
    "When enabled, YourPods removes known tracking redirects from episode URLs before playback. Your device connects directly to the audio host." : {
      "comment" : "Section footer under the main P3 toggle. P3 and YourPods are names and stay untranslated; 'tracking redirects' are the analytics hops an episode URL is chained through, and 'the audio host' is the server that stores the episode file. A footer, so full sentences are fine.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, entfernt YourPods bekannte Tracking-Weiterleitungen vor der Wiedergabe aus den Folgen-URLs. Dein Gerät verbindet sich direkt mit dem Audio-Host."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, YourPods elimina de las URL de los episodios las redirecciones de seguimiento conocidas antes de la reproducción. Tu dispositivo se conecta directamente al servidor que aloja el audio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque cette option est activée, YourPods retire des URL des épisodes les redirections de suivi connues avant la lecture. Votre appareil se connecte directement à l'hébergeur du fichier audio."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se attivo, YourPods rimuove dagli URL degli episodi i redirect di tracciamento noti prima della riproduzione. Il tuo dispositivo si collega direttamente all'host audio."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als dit aanstaat, verwijdert YourPods bekende trackingredirects uit de URL's van afleveringen voordat het afspelen begint. Je apparaat maakt rechtstreeks verbinding met de audiohost."
          }
        }
      }
    },
    "When on, you'll be notified when new episodes are found during background refresh" : {
      "comment" : "VoiceOver hint on the per-podcast New Episode Notifications toggle — heard, not read. 'When on' refers to the switch being enabled.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, wirst du benachrichtigt, sobald bei der Hintergrundaktualisierung neue Folgen gefunden werden"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, recibirás una notificación cuando se encuentren episodios nuevos durante la actualización en segundo plano"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque cette option est activée, vous êtes averti quand de nouveaux épisodes sont détectés lors de l'actualisation en arrière-plan"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se attivo, riceverai una notifica quando vengono trovati nuovi episodi durante l'aggiornamento in background"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als dit aanstaat, krijg je een melding wanneer er tijdens het vernieuwen op de achtergrond nieuwe afleveringen worden gevonden"
          }
        }
      }
    },
    "When you create a YourPods Sync account, we collect and store only the minimum data necessary for sync functionality:" : {
      "comment" : "Body sentence on the data-transparency screen introducing the bulleted list of stored data that follows it, which is why it ends in a colon. 'YourPods Sync' is a product name and is never translated.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du einen YourPods Sync-Account erstellst, erfassen und speichern wir nur die Daten, die für die Synchronisierung unbedingt nötig sind:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando creas una cuenta de YourPods Sync, solo recopilamos y almacenamos los datos mínimos necesarios para la sincronización:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque vous créez un compte YourPods Sync, nous ne collectons et ne conservons que les données strictement nécessaires à la synchronisation :"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando crei un account YourPods Sync, raccogliamo e conserviamo solo i dati minimi necessari al funzionamento della sincronizzazione:"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wanneer je een YourPods Sync-account aanmaakt, verzamelen en bewaren we alleen de gegevens die minimaal nodig zijn om te kunnen synchroniseren:"
          }
        }
      }
    },
    "Why are you leaving? (optional)" : {
      "comment" : "Greyed-out prompt inside the free-text field where a user who is deleting their account may say why. '(optional)' tells them they can leave it empty.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warum gehst du? (optional)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Por qué te vas? (opcional)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pourquoi partez-vous ? (facultatif)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perché ci lasci? (facoltativo)"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waarom ga je weg? (optioneel)"
          }
        }
      }
    },
    "Wi-Fi Only Downloads" : {
      "comment" : "Toggle label in Settings -> Apple Watch: let the watch download episodes only over Wi-Fi, never over cellular. 'Wi-Fi' keeps its standard spelling.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloads nur über WLAN"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descargas solo por Wi-Fi"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Téléchargements en Wi-Fi uniquement"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download solo via Wi-Fi"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen downloads via Wi-Fi"
          }
        }
      }
    },
    "Wi-Fi Only Downloads saves watch battery by avoiding cellular radio for episode downloads." : {
      "comment" : "Section footer under the Apple Watch settings. 'Wi-Fi Only Downloads' is the toggle just above and must match its translation; 'cellular radio' means the mobile-data antenna. A footer, so a full sentence is fine.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Downloads nur über WLAN“ schont den Akku der Watch, weil für Folgen-Downloads kein Mobilfunk genutzt wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La opción Descargas solo por Wi-Fi ahorra batería del reloj al evitar la antena de datos móviles en las descargas de episodios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Téléchargements en Wi-Fi uniquement préserve la batterie de la montre en évitant d'utiliser le réseau cellulaire pour télécharger les épisodes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'opzione Download solo via Wi-Fi preserva la batteria dell'Apple Watch evitando l'uso della rete cellulare per scaricare gli episodi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen downloads via Wi-Fi spaart de batterij van je Apple Watch doordat afleveringen niet via het mobiele netwerk worden gedownload."
          }
        }
      }
    },
    "With a YourPods Sync Account" : {
      "comment" : "Section header on the data-transparency screen covering what is stored once the user signs in. 'YourPods Sync' is a product name and is never translated. Translate in normal case — iOS applies capitalisation styling itself.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit einem YourPods Sync-Account"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con una cuenta de YourPods Sync"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec un compte YourPods Sync"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con un account YourPods Sync"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met een YourPods Sync-account"
          }
        }
      }
    },
    "With self-hosted gPodder sync (e.g. Nextcloud), your data goes to your own server, never to us." : {
      "comment" : "Body sentence on the data-transparency screen about self-hosted syncing. 'gPodder' and 'Nextcloud' are product names and are never translated; 'never to us' means never to the makers of the app.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei selbst gehostetem gPodder-Sync (z. B. Nextcloud) gehen deine Daten an deinen eigenen Server, niemals an uns."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con la sincronización gPodder autoalojada (por ejemplo, Nextcloud), tus datos van a tu propio servidor, nunca a nosotros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec une synchronisation gPodder auto-hébergée (par exemple Nextcloud), vos données vont sur votre propre serveur, jamais chez nous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con la sincronizzazione gPodder self-hosted (ad esempio Nextcloud), i tuoi dati vanno sul tuo server, mai a noi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij zelf gehoste gPodder-synchronisatie (bijvoorbeeld Nextcloud) gaan je gegevens naar je eigen server, nooit naar ons."
          }
        }
      }
    },
    "Without an Account" : {
      "comment" : "Section header on the data-transparency screen covering what happens when the user signs in nowhere at all. Translate in normal case — iOS applies capitalisation styling itself.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Account"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin cuenta"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans compte"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza un account"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zonder account"
          }
        }
      }
    },
    "Works with any gPodder-compatible app" : {
      "comment" : "Feature bullet for the gpodder.net card. gPodder is a protocol/product name — do not translate.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funktioniert mit jeder gPodder-kompatiblen App"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funciona con cualquier app compatible con gPodder"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonctionne avec toute app compatible gPodder"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funziona con qualsiasi app compatibile con gPodder"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werkt met elke gPodder-compatibele app"
          }
        }
      }
    },
    "You can change the app's language any time in Settings." : {
      "comment" : "Second line of the first-run translation sheet. 'Settings' here means Apple's own Settings app, not YourPods' settings screen — use whatever your language's iOS calls the system Settings app.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst die Sprache der App jederzeit in den Einstellungen ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes cambiar el idioma de la app cuando quieras en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez changer la langue de l'app à tout moment dans Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi cambiare la lingua dell'app in qualsiasi momento in Impostazioni."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt de taal van de app altijd wijzigen in Instellingen."
          }
        }
      }
    },
    "You can override this global setting for individual podcasts. Go to Library → tap a podcast → Settings → Privacy to enable or disable P3 for specific shows." : {
      "comment" : "P3 explanation detail. 'Library → tap a podcast → Settings → Privacy' is a navigation path — translate the words, keep the arrows. P3 is a product feature name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst diese globale Einstellung für einzelne Podcasts außer Kraft setzen. Gehe zu Mediathek → tippe auf einen Podcast → Einstellungen → Datenschutz, um P3 für bestimmte Sendungen zu aktivieren oder zu deaktivieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes anular este ajuste global para podcasts concretos. Ve a Biblioteca → toca un podcast → Ajustes → Privacidad para activar o desactivar P3 en programas concretos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez remplacer ce réglage global pour des podcasts individuels. Accédez à Bibliothèque → touchez un podcast → Réglages → Confidentialité pour activer ou désactiver P3 pour des émissions spécifiques."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi sovrascrivere questa impostazione globale per i singoli podcast. Vai in Libreria → tocca un podcast → Impostazioni → Privacy per attivare o disattivare P3 per podcast specifici."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt deze algemene instelling voor afzonderlijke podcasts overschrijven. Ga naar Bibliotheek → tik op een podcast → Instellingen → Privacy om P3 voor specifieke shows in of uit te schakelen."
          }
        }
      }
    },
    "You can switch between any mode at any time without losing your local data — subscriptions, downloads, and queue are always preserved." : {
      "comment" : "Reassurance shown on the About Account Types screen. 'mode' = account type. The em dash introduces the list of what is preserved.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst jederzeit zwischen den Modi wechseln, ohne deine lokalen Daten zu verlieren – Abos, Downloads und Warteschlange bleiben immer erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes cambiar de modo en cualquier momento sin perder tus datos locales: las suscripciones, las descargas y la cola siempre se conservan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez passer d'un mode à l'autre à tout moment sans perdre vos données locales — abonnements, téléchargements et file d'attente sont toujours conservés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi passare da una modalità all'altra in qualsiasi momento senza perdere i tuoi dati locali — iscrizioni, download e coda vengono sempre conservati."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt op elk moment tussen modi wisselen zonder je lokale gegevens te verliezen — abonnementen, downloads en wachtrij blijven altijd behouden."
          }
        }
      }
    },
    "You may have multiple account types. Choose where to save your podcast data." : {
      "comment" : "Tagline under the onboarding chooser title, and on the About Account Types screen. Tells the user they can pick where their data lives.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst mehrere Kontotypen haben. Wähle, wo deine Podcast-Daten gespeichert werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes tener varios tipos de cuenta. Elige dónde guardar los datos de tus podcasts."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez avoir plusieurs types de comptes. Choisissez où enregistrer vos données de podcasts."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi avere più tipi di account. Scegli dove salvare i dati dei tuoi podcast."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt meerdere accounttypes hebben. Kies waar je je podcastgegevens wilt bewaren."
          }
        }
      }
    },
    "You're all caught up!" : {
      "comment" : "Cheerful empty state under the Home screen's 'Recently Updated' heading, shown when there are no new unplayed episodes. Idiomatic — use a natural equivalent in your language rather than a literal translation.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist auf dem neuesten Stand!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Estás al día!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes à jour !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei in pari!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je bent helemaal bij!"
          }
        }
      }
    },
    "you@example.com" : {
      "comment" : "Greyed-out example address inside the email field. Do NOT translate: example.com is a reserved example domain and the string must stay a valid email address.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
