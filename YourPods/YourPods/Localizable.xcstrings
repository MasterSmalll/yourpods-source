    "Good to Know" : {
      "comment" : "Section header on the P3 screen introducing caveats and trade-offs. An idiomatic heading meaning 'things worth knowing'. Translate in normal case — iOS applies capitalisation styling itself.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gut zu wissen"
          }
        },
        "es" : {
          "stringUnit" : {
