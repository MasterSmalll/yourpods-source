    "Returns your listening time and streaks as numbers you can use in shortcuts." : {
      "comment" : "Help sentence shown under the action name 'Get Listening Stats' in the Shortcuts app. A streak is a run of consecutive days with listening; lowercase 'shortcuts' means user-built shortcuts in Apple's Shortcuts app.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gibt deine Hörzeit und deine Serien als Zahlen zurück, die du in Kurzbefehlen verwenden kannst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devuelve tu tiempo de escucha y tus rachas como números que puedes usar en tus atajos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fournit votre temps d'écoute et vos séries de jours consécutifs sous forme de nombres utilisables dans vos raccourcis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restituisce il tuo tempo di ascolto e le tue serie di giorni consecutivi come numeri che puoi usare nei tuoi comandi rapidi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geeft je luistertijd en reeksen terug als getallen die je in opdrachten kunt gebruiken."
          }
        }
      }
    },
