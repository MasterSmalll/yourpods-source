    "Syncing episode activity" : {
      "comment" : "VoiceOver label that replaces 'Refresh episode activity' on the refresh button while a sync with the gPodder server is running. It reports an in-progress state, so a present-progressive phrasing is intended. Heard, not read.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folgenaktivität wird synchronisiert"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronizando la actividad de episodios"
          }
        },
