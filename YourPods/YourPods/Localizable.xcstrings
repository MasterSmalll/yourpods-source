          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vernieuw je podcasts en synchroniseer, en meld daarna hoeveel nieuwe afleveringen er zijn binnengekomen."
          }
        }
      }
    },
    "Remaining (seconds)" : {
