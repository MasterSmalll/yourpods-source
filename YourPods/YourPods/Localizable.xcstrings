    "How would you like to receive notifications?" : {
      "comment" : "Title of the confirmation dialog (action sheet) shown when the user switches on New Episode Notifications, above the buttons 'All Podcasts', 'Let Me Choose' and 'Cancel'. A question addressed to the user.",
      "localizations" : {
