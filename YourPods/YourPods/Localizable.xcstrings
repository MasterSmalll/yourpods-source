          }
        }
      }
    },
    "Accept" : {
      "comment" : "Button on a sync-conflict row where the server reports that a podcast's feed address has moved; tapping it replaces the locally stored feed URL with the server's new one. The VERB 'to accept', paired with the 'Keep Local' button beside it. Narrow button — keep it short.",
      "localizations" : {
