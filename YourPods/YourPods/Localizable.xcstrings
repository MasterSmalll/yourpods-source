          }
        }
      }
    },
    "Returns a share link to the current episode at the current timestamp." : {
      "comment" : "Help sentence shown under the action name 'Get Share Link' in the Shortcuts app. 'Returns' describes the value the action hands to the next step of a shortcut; 'timestamp' is the exact playback position.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gibt einen Link zur aktuellen Folge an der aktuellen Zeitmarke zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devuelve un enlace para compartir el episodio actual en la posición de reproducción actual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fournit un lien de partage vers l'épisode en cours, à la position de lecture actuelle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restituisce un link di condivisione dell'episodio corrente alla posizione di riproduzione attuale."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geeft een deellink terug naar de huidige aflevering op de huidige afspeelpositie."
          }
        }
      }
    },
    "Returns a timestamped link to the current episode, ready to send." : {
      "comment" : "Help sentence shown under the action name \"Share What I'm Listening To\" in the Shortcuts app. 'Timestamped' = the link opens at the exact second the user is at; 'ready to send' = it can be passed straight to Messages, Mail and so on.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gibt einen Link mit Zeitmarke zur aktuellen Folge zurück – fertig zum Versenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devuelve un enlace con marca de tiempo al episodio actual, listo para enviar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fournit un lien horodaté vers l'épisode en cours, prêt à être envoyé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restituisce un link all'episodio corrente con la posizione di riproduzione, pronto da inviare."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geeft een link terug naar de huidige aflevering op de huidige afspeelpositie, klaar om te versturen."
          }
        }
      }
    },
    "Returns the episode that's currently playing, with its position, duration, and link." : {
      "comment" : "Help sentence shown under the action name 'Get Current Episode' in the Shortcuts app. Position, duration and link are the names of fields on the returned Episode value — keep them consistent with those field labels.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gibt die aktuell abgespielte Folge zurück – mit Position, Dauer und Link."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devuelve el episodio que se está reproduciendo, con su posición, duración y enlace."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fournit l'épisode en cours de lecture, avec sa position, sa durée et son lien."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
