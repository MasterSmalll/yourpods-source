    "Unlike Delete Profile (which only disconnects this device), deleting your account permanently removes your YourPods Sync account and all data from the server. This cannot be undone." : {
      "comment" : "Footer of the account-deletion section spelling out the difference between the two destructive actions. 'Delete Profile' quotes the button of that name — translate it exactly as you translated that button.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anders als „Profil löschen“ (womit nur dieses Gerät getrennt wird) entfernt das Löschen deines Accounts deinen YourPods Sync-Account und alle Daten dauerhaft vom Server. Das kann nicht rückgängig gemacht werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A diferencia de Eliminar perfil (que solo desconecta este dispositivo), eliminar tu cuenta borra de forma permanente tu cuenta de YourPods Sync y todos los datos del servidor. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contrairement à Supprimer le profil (qui déconnecte seulement cet appareil), la suppression de votre compte efface définitivement votre compte YourPods Sync et toutes vos données du serveur. Cette action est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A differenza di Elimina profilo (che disconnette solo questo dispositivo), l'eliminazione dell'account rimuove definitivamente il tuo account YourPods Sync e tutti i dati dal server. L'operazione non può essere annullata."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In tegenstelling tot Verwijder profiel (waarmee alleen dit apparaat wordt losgekoppeld) worden bij het verwijderen van je account je YourPods Sync-account en alle gegevens definitief van de server gewist. Dit kan niet ongedaan worden gemaakt."
          }
        }
      }
    },
    "Unplayed episodes older than %lld days will be auto-hidden for this podcast." : {
      "comment" : "Section footer in one podcast's Listening Profile sheet, shown when this show has its own auto-hide span. Plural rules handle the count; it counts days. A footer, so a full sentence is fine.",
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Ungespielte Folgen, die älter als %lld Tag sind, werden bei diesem Podcast automatisch ausgeblendet."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Ungespielte Folgen, die älter als %lld Tage sind, werden bei diesem Podcast automatisch ausgeblendet."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
