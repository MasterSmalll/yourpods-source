            "value" : "Servicevoorwaarden"
          }
        }
      }
    },
    "Text & Icon" : {
      "comment" : "Picker option for the tab bar style: show both the icon and its text label. Sits in a segmented row next to 'Text Only' and 'Icon Only', so it must stay very short; the ampersand may become the local 'and' word.",
