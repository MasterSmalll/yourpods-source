    "Credentials will be sent unencrypted over HTTP. Use HTTPS for security." : {
      "comment" : "Warning under the protected-feed URL field when the address the user entered starts with http:// instead of https://. HTTP and HTTPS are protocol names — keep them as they are.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zugangsdaten werden unverschlüsselt über HTTP gesendet. Verwende HTTPS für mehr Sicherheit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las credenciales se enviarán sin cifrar por HTTP. Usa HTTPS para mayor seguridad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les identifiants seront envoyés en clair via HTTP. Utilisez HTTPS pour plus de sécurité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le credenziali verranno inviate senza crittografia tramite HTTP. Per sicurezza usa HTTPS."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inloggegevens worden onversleuteld via HTTP verstuurd. Gebruik HTTPS voor de veiligheid."
          }
        }
      }
    },
