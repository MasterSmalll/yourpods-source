          }
        }
      }
    },
    "Returns the episodes in your Up Next queue." : {
      "comment" : "Help sentence shown under the action name 'Get Queue' in the Shortcuts app. 'Up Next' is the on-screen name of the queue (the ordered list of episodes to play) — match the app's Up Next screen wording.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
