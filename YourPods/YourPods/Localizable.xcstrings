    "Every subscription funds development directly." : {
      "comment" : "Second, smaller line of the indie-support message at the bottom of the YourPods Pro paywall, following 'Built indie. Funded by listeners.'. 'Subscription' here means a paid Pro plan (not a subscribed podcast), and 'development' means continued work on the app.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Abo finanziert die Entwicklung direkt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada suscripción financia el desarrollo directamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque abonnement finance directement le développement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni abbonamento finanzia direttamente lo sviluppo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elk abonnement financiert de ontwikkeling rechtstreeks."
          }
        }
      }
    },
    "Everything in Free, plus:" : {
      "comment" : "Feature bullet that introduces the Pro-only features below it on the YourPods Pro card. 'Free' is the tier name. The trailing colon leads into the list that follows.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles aus Free, plus:"
          }
        },
        "es" : {
