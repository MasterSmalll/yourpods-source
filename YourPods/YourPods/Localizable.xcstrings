    "Restart Episode" : {
      "comment" : "Starts the current episode again from the beginning (it does not go to the previous episode). Used as the VoiceOver label of the back button in the full player, as the title of a Siri/Shortcuts action, and as a choice in the Settings picker for what a headphone previous-track press should do.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
