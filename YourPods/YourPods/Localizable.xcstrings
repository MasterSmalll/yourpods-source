    "Many podcast analytics services track when you download or stream an episode. P3 bypasses these trackers." : {
      "comment" : "P3 explanation detail. P3 is a product feature name — do not translate. 'bypasses' = routes around / avoids.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viele Podcast-Analysedienste erfassen, wann du eine Episode herunterlädst oder streamst. P3 umgeht diese Tracker."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muchos servicios de analíticas de podcasts registran cuándo descargas o reproduces un episodio. P3 evita estos rastreadores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De nombreux services d'analyse de podcasts enregistrent le moment où vous téléchargez ou écoutez un épisode en streaming. P3 contourne ces traqueurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Molti servizi di analisi per podcast registrano quando scarichi o riproduci in streaming un episodio. P3 aggira questi tracker."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veel podcast-analysediensten registreren wanneer je een aflevering downloadt of streamt. P3 omzeilt deze trackers."
          }
        }
      }
    },
