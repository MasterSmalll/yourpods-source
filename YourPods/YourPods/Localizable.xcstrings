    },
    "Save a timestamped note on the episode you're listening to — hands-free." : {
      "comment" : "Help sentence shown under the action name 'Bookmark This Moment' in the Shortcuts app. 'Timestamped note' = a short text saved against the exact playback position; 'hands-free' means the user can trigger it by voice without touching the device. The em dash may be replaced with normal punctuation for your language.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichert eine Notiz mit Zeitmarke zu der Folge, die du gerade hörst – ganz freihändig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda una nota con marca de tiempo en el episodio que estás escuchando, sin usar las manos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistre une note horodatée sur l'épisode que vous écoutez, en mode mains libres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva una nota con la posizione di riproduzione sull'episodio che stai ascoltando, senza usare le mani."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaar een notitie met de afspeelpositie bij de aflevering waar je naar luistert — handsfree."
          }
        }
      }
    },
    "Save Credentials" : {
      "comment" : "Button that stores the typed username and password for a password-protected RSS feed in the device Keychain. 'Save' is the VERB; 'Credentials' means the login details.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zugangsdaten speichern"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardar credenciales"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrer les identifiants"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva credenziali"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaar inloggegevens"
          }
        }
      }
    },
    "Save everything on this phone only. No internet account needed. Start listening now." : {
      "comment" : "One-line description under the Vault Mode card. Three short promises: local-only storage, no account, immediate use. 'this phone' = the user's device.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichere alles nur auf diesem Gerät. Kein Online-Konto nötig. Jetzt loshören."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda todo solo en este teléfono. No necesitas ninguna cuenta en internet. Empieza a escuchar ya."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez tout uniquement sur ce téléphone. Aucun compte en ligne requis. Commencez à écouter dès maintenant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva tutto solo su questo telefono. Nessun account online necessario. Inizia subito ad ascoltare."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaar alles alleen op deze telefoon. Geen internetaccount nodig. Begin nu met luisteren."
          }
        }
      }
    },
    "Save Password" : {
      "comment" : "Toggle in the credentials form; when it is on, the password is stored in the device's Keychain. 'Save' is the VERB, 'Password' the noun.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passwort speichern"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardar contraseña"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrer le mot de passe"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva password"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaar wachtwoord"
          }
        }
      }
    },
    "Save your progress using the community-run public gpodder.net service. (Note: Their privacy rules will apply)." : {
      "comment" : "One-line description under the gpodder.net card. gpodder.net is a product name — do not translate. 'Their' = gpodder.net's operators. Keep the parenthetical note.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichere deinen Fortschritt über den öffentlichen, von der Community betriebenen Dienst gpodder.net. (Hinweis: Es gelten deren Datenschutzregeln.)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda tu progreso con el servicio público gpodder.net, gestionado por la comunidad. (Nota: se aplicarán sus normas de privacidad)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez votre progression avec le service public gpodder.net, géré par la communauté. (Remarque : leurs règles de confidentialité s'appliqueront)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva i tuoi progressi usando il servizio pubblico gpodder.net gestito dalla community. (Nota: si applicheranno le loro regole sulla privacy)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaar je voortgang met de openbare, door de community beheerde gpodder.net-dienst. (Let op: hun privacyregels zijn van toepassing)."
          }
        }
      }
    },
    "Say \"Hey Siri\" followed by any phrase. Every action above is also available in the Shortcuts app." : {
      "comment" : "Section footer under the list of Siri phrases. 'Hey Siri' is the wake phrase — write it exactly as Apple uses it in this language, in quotation marks; 'Shortcuts app' is Apple's app name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sage „Hey Siri“, gefolgt von einem beliebigen Satz. Alle Aktionen oben sind auch in der Kurzbefehle-App verfügbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di «Oye Siri» seguido de cualquier frase. Todas las acciones anteriores también están disponibles en la app Atajos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dites « Dis Siri » suivi de n'importe quelle phrase. Toutes les actions ci-dessus sont également disponibles dans l'app Raccourcis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di' \"Ehi Siri\" seguito da una qualsiasi frase. Tutte le azioni qui sopra sono disponibili anche nell'app Comandi rapidi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeg \"Hey Siri\" gevolgd door een willekeurige zin. Elke actie hierboven is ook beschikbaar in de Opdrachten-app."
          }
        }
      }
    },
    "Scanning library for old episodes" : {
      "comment" : "VoiceOver label for the auto-hide progress sheet while it is still scanning — heard, not read, and read aloud instead of the visible headline. 'Library' is the app's library of subscribed podcasts.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mediathek wird nach alten Folgen durchsucht"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buscando episodios antiguos en la biblioteca"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analyse de la bibliothèque à la recherche d'anciens épisodes"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scansione della libreria alla ricerca di episodi vecchi"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bibliotheek wordt gescand op oude afleveringen"
          }
        }
      }
    },
    "Scanning Library…" : {
      "comment" : "Visible headline in the auto-hide progress sheet while the sweep is running. 'Library' is the name of the app's Library tab — match that translation. The trailing ellipsis signals work in progress.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mediathek wird durchsucht …"
          }
        },
        "es" : {
