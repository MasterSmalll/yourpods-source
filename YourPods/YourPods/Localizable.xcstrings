        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles uit Gratis, plus:"
          }
        }
      }
    },
    "Everything on-device" : {
      "comment" : "Feature bullet for Vault Mode. Very short. Means all data stays on the user's device.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles auf dem Gerät"
