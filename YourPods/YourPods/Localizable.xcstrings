    "Tap + to search and add podcasts." : {
      "comment" : "Description of the 'No Podcasts' empty state in the Library. The '+' refers to the plus button in the navigation bar — keep the literal character.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf +, um Podcasts zu suchen und hinzuzufügen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca + para buscar y añadir podcasts."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez + pour rechercher et ajouter des podcasts."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca + per cercare e aggiungere podcast."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op + om podcasts te zoeken en toe te voegen."
          }
        }
      }
    },
    "Tap to also search episode descriptions." : {
      "comment" : "VoiceOver hint (heard, not read) for the 'Search Details' chip while description search is OFF; activating the chip turns it on.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippen, um auch Folgenbeschreibungen zu durchsuchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca para buscar también en las descripciones de los episodios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez pour rechercher aussi dans les descriptions des épisodes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca per cercare anche nelle descrizioni degli episodi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik om ook in afleveringsbeschrijvingen te zoeken."
          }
        }
      }
    },
    "Tells you the next episode in your queue and returns it." : {
      "comment" : "Help sentence shown under the action name \"What's Next in Queue\" in the Shortcuts app. 'Tells you' = Siri speaks the answer aloud; 'returns it' = the episode is also handed to the next step of a shortcut. Queue = the ordered list of episodes to play.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nennt dir die nächste Folge in deiner Warteliste und gibt sie zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te dice cuál es el siguiente episodio de tu cola y lo devuelve."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indique l'épisode suivant de votre file d'attente et le fournit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti dice qual è il prossimo episodio nella tua coda e lo restituisce."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertelt welke aflevering als volgende in je wachtrij staat en geeft die terug."
          }
        }
      }
    },
    "Terms" : {
      "comment" : "Very short text link at the bottom of the Pro paywall, next to 'Privacy', that opens the Terms of Service web page. It is the abbreviated name of that legal document, not the general word for vocabulary or conditions. Space is extremely tight — keep it to one short word if possible.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AGB"
