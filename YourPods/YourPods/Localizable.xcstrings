          "stringUnit" : {
            "state" : "translated",
            "value" : "Afleveringsactiviteit wordt gesynchroniseerd"
          }
        }
      }
    },
    "Syncing positions…" : {
      "comment" : "NOT a Siri string: a small caption under a spinner in an overlay the app shows at launch while it applies each episode's saved playback position. Progress phrasing ('in progress' style), must stay short, and the trailing character is a single ellipsis.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisiere Positionen …"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronizando posiciones…"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisation des positions…"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronizzazione posizioni…"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posities synchroniseren…"
          }
        }
      }
    },
    "Syncing…" : {
      "comment" : "Replaces 'Sync to Nextcloud' on that menu item while the upload is running. A status in progress; note it uses a real ellipsis character (…), not three dots.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisiere …"
          }
        },
        "es" : {
