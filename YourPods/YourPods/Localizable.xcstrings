    "What would you like to do with this episode?" : {
      "comment" : "Message of the queue-removal dialog on repeat visits, once the user has already been told the choice is remembered. The buttons below it are 'Remove' and 'Remove & Mark as Played'.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was möchtest du mit dieser Folge machen?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué quieres hacer con este episodio?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que voulez-vous faire de cet épisode ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cosa vuoi fare con questo episodio?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wat wil je met deze aflevering doen?"
          }
        }
      }
    },
    "What would you like to do? Your choice will be remembered. You can change this later in Settings → Queue Management." : {
      "comment" : "Message of the queue-removal dialog the first time it appears. 'Settings' is the settings screen and 'Queue Management' is a section header inside it — use exactly the translations you gave those two items, and keep the → arrow between them.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was möchtest du tun? Deine Auswahl wird gespeichert. Du kannst das später unter Einstellungen → Wartelistenverwaltung ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué quieres hacer? Se recordará tu elección. Puedes cambiarlo más adelante en Ajustes → Gestión de la cola."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que voulez-vous faire ? Votre choix sera mémorisé. Vous pourrez le modifier plus tard dans Réglages → Gestion de la file d'attente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cosa vuoi fare? La tua scelta verrà memorizzata. Potrai modificarla in seguito in Impostazioni → Gestione della coda."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wat wil je doen? Je keuze wordt onthouden. Je kunt dit later wijzigen in Instellingen → Wachtrijbeheer."
          }
        }
      }
    },
    "What's Next in Queue" : {
      "comment" : "Intent TITLE, the action name in the Shortcuts app: which episode will play next. Phrased as a question in English; keep it short, and Queue = the ordered list of episodes to play (Up Next on screen).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was kommt als Nächstes"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siguiente en la cola"
          }
        },
        "fr" : {
          "stringUnit" : {
