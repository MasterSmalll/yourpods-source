    "Add" : {
      "comment" : "Navigation-bar confirmation button that saves the sync account just typed into the add-account sheet (gpodder.net credentials, or manual Nextcloud credentials). The VERB. Toolbar space is tight — one short word.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinzufügen"
