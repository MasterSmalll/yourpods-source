          }
        }
      }
    },
    "Scheduled: %@" : {
      "comment" : "Caption inside the red live-episode banner on a podcast's screen, giving when an upcoming live stream starts. Argument 1 is an already-formatted date and time such as 'Jul 21, 2026 at 3:00 PM'. Keep the colon or use your language's punctuation for a label/value pair.",
      "localizations" : {
