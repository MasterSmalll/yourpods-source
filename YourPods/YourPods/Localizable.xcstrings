    "Mark Played and Play Next" : {
      "comment" : "Intent TITLE, the action name in the Shortcuts app. Two verbs: mark the current episode as played (finished), then start the next episode in the queue. English Title Case is house style only.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als gespielt markieren und nächste Folge abspielen"
          }
        },
        "es" : {
          "stringUnit" : {
